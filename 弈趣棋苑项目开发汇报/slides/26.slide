<Slide style={{ width: 1280, height: 720, padding: "20px 72px", background: "#F5E3BE", flexDirection: "column" }}>
  <Box style={{ width: "100%", height: 122, flexDirection: "column", justifyContent: "center" }}>
    <Text style={{ fontSize: 34, fontWeight: "bold", color: "#2A2118", fontFamily: "'Songti SC', 'STSong', 'SimSun', serif" }}>原理 · 象棋接入本地 Pikafish NNUE</Text>
    <Box style={{ width: 56, height: 2, background: "#B3271E", marginTop: 10 }} />
    <Text style={{ fontSize: 16, lineHeight: 1.5, color: "rgba(42,33,24,0.62)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif", marginTop: 8 }}>象棋不用自研引擎，而是把本地皮卡鱼当成一个说 UCI 协议的外部进程来用</Text>
  </Box>
  <Box style={{ width: "100%", height: 510, flexDirection: "column" }}>
  <Box style={{ width: "100%", height: "100%", flexDirection: "column" }}>
  <Box style={{ flexDirection: "row", height: "100%", gap: 30, alignItems: "center" }}>
    <Box style={{ width: 520, flexDirection: "column", justifyContent: "center", gap: 10, alignItems: "center" }}>
    <svg width="900" height="150" viewBox="0 0 900 150" style={{ background: "rgba(140,90,43,0.05)", borderRadius: 10, maxWidth: "100%", height: "auto" }}>
      <rect x="20" y="55" width="130" height="40" rx="8" fill="#8C5A2B"/><text x="85" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">主线程</text>
      <rect x="175" y="55" width="150" height="40" rx="8" fill="#B3271E"/><text x="250" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">起 UCI 子进程</text>
      <rect x="350" y="55" width="130" height="40" rx="8" fill="#2A2118"/><text x="415" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">uci → isready</text>
      <rect x="505" y="55" width="120" height="40" rx="8" fill="#2A2118"/><text x="565" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">position</text>
      <rect x="650" y="55" width="90" height="40" rx="8" fill="#2A2118"/><text x="695" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">go</text>
      <rect x="765" y="55" width="115" height="40" rx="8" fill="#8C5A2B" opacity="0.72"/><text x="822" y="80" font-size="13" fill="#F5E3BE" text-anchor="middle" font-family="sans-serif">bestmove</text>
      <line x1="150" y1="75" x2="175" y2="75" stroke="#2A2118" stroke-width="2"/><line x1="325" y1="75" x2="350" y2="75" stroke="#2A2118" stroke-width="2"/><line x1="480" y1="75" x2="505" y2="75" stroke="#2A2118" stroke-width="2"/><line x1="625" y1="75" x2="650" y2="75" stroke="#2A2118" stroke-width="2"/><line x1="740" y1="75" x2="765" y2="75" stroke="#2A2118" stroke-width="2"/>
    </svg>
      <Text style={{ fontSize: 14, lineHeight: 1.4, color: "rgba(42,33,24,0.6)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif" }}>UCI 协议封装：起子进程走 uci→isready→position→go，三档难度=搜索深度</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: "column", justifyContent: "center", gap: 6 }}>
    <Box style={{ flexDirection: "row", alignItems: "flex-start", gap: 12, marginBottom: 13 }}>
      <Box style={{ width: 7, height: 7, borderRadius: 2, background: "#B3271E", marginTop: 9 }} />
      <Text style={{ fontSize: 16, lineHeight: 1.64, color: "rgba(42,33,24,0.8)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif", flex: 1 }}>通信走标准 UCI 文本协议，引擎可随时替换、可单独升级。</Text>
    </Box>
    <Box style={{ flexDirection: "row", alignItems: "flex-start", gap: 12, marginBottom: 13 }}>
      <Box style={{ width: 7, height: 7, borderRadius: 2, background: "#B3271E", marginTop: 9 }} />
      <Text style={{ fontSize: 16, lineHeight: 1.64, color: "rgba(42,33,24,0.8)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif", flex: 1 }}>子进程隔离：引擎崩溃不会连带主程序，只是这一手走不出来。</Text>
    </Box>
    <Box style={{ flexDirection: "row", alignItems: "flex-start", gap: 12, marginBottom: 13 }}>
      <Box style={{ width: 7, height: 7, borderRadius: 2, background: "#B3271E", marginTop: 9 }} />
      <Text style={{ fontSize: 16, lineHeight: 1.64, color: "rgba(42,33,24,0.8)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif", flex: 1 }}>三档难度通过 go depth / movetime 调节，不改编引擎本身。</Text>
    </Box>
    </Box>
  </Box>
  <Box style={{ width: "100%", background: "rgba(42,33,24,0.94)", borderLeft: "5px solid #B3271E", borderRadius: 6, padding: "10px 20px", marginTop: 4 }}>
    <Text style={{ fontSize: 15, lineHeight: 1.45, color: "rgba(245,227,190,0.92)", fontFamily: "'PingFang SC', 'Microsoft YaHei', sans-serif" }}>接入原则：能用成熟引擎的地方不重复造轮子，把精力留给界面与体验。</Text>
  </Box>
  </Box>
